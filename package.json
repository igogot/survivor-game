{
  "name": "survivor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Survivor-like roguelite built on a hand-written fixed-timestep loop, object pools and a spatial-hash broad-phase.",
  "scripts": {
    "start": "vite --open",
    "dev": "vite",
    "limits": "vite-node scripts/emit-limits.ts",
    "build": "tsc --noEmit && npm run limits && vite build && vite-node scripts/scrub-dist.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:api": "php tests/api.php",
    "test:watch": "vitest",
    "balance": "vitest run --config vitest.balance.config.ts",
    "endless": "vitest run --config vitest.endless.config.ts",
    "perf": "vitest run --config vitest.perf.config.ts"
  },
  "dependencies": {
    "pixi.js": "^8.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0"
  }
}
